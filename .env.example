# From @BotFather after creating the bot
TELEGRAM_BOT_TOKEN=

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# One of: sonnet / opus / fable -- automatically resolves to the newest
# anthropic/claude-<family>-* model on OpenRouter each run. Or set an exact
# slug from https://openrouter.ai/models to pin a specific version instead.
# Leave blank to default to "sonnet".
OPENROUTER_MODEL=

# Your boss's Google Calendar address (usually his email). He must have
# shared this calendar with your Google account with "Make changes to
# events" permission.
BOSS_CALENDAR_ID=

# IANA timezone used to interpret dates/times mentioned in chat. Leave blank
# to default to Etc/GMT-3 (fixed UTC+3).
TIMEZONE=

# Default meeting length, in minutes, when the chat doesn't state one.
# Leave blank to default to 120.
DEFAULT_DURATION_MINUTES=

# Paths (relative to this folder) used by google_auth_setup.py and bot.py.
# Defaults shown -- usually no need to change these.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Alternative to a token.json file on disk: paste the exact file contents
# here as one line. Useful for cloud hosts (e.g. Fly.io secrets) where
# there's no easy way to upload a file. If set, this always overwrites
# GOOGLE_TOKEN_PATH on startup. Leave blank when running locally with an
# actual token.json file present.
GOOGLE_TOKEN_JSON=
